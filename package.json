{
	"name": "wrk",
	"version": "1.0.0",
	"description": "A minimal CLI for quickly opening projects in your IDE",
	"module": "src/index.ts",
	"type": "module",
	"bin": {
		"wrk": "./dist/wrk.js"
	},
	"scripts": {
		"build": "bun build --target=bun --outfile=./dist/wrk.js src/index.ts --minify",
		"install-global": "bun run build && cp dist/wrk.js /usr/local/bin/wrk",
		"link": "bun run build && bun link",
		"test": "bun test"
	},
	"keywords": [
		"cli",
		"workspace",
		"productivity",
		"ide"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"commander": "^14.0.3",
		"inquirer": "^13.3.2"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^14.0.0",
		"@types/bun": "^1.3.11",
		"@types/commander": "^2.12.5",
		"@types/inquirer": "^9.0.9",
		"@types/node": "^25.5.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	}
}
